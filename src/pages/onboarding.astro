---
import AuthCard from "../components/AuthCard.astro";
import MarketingLayout from "../layouts/MarketingLayout.astro";
---

<MarketingLayout title="Set up your goals — Keyrate" showCta={false}>
  <AuthCard title="Welcome!" subtitle="Set a couple of goals so we know what to aim for.">
    <form id="onboarding-form">
      <label>
        Target speed (WPM)
        <input type="number" name="speedGoal" min="10" max="200" step="5" value="40" required />
      </label>
      <label>
        Daily practice goal (minutes)
        <input type="number" name="dailyMinutes" min="5" max="120" step="5" value="15" required />
      </label>
      <button type="submit">Finish setup</button>
      <p class="form-status" id="onboarding-status"></p>
    </form>
  </AuthCard>
</MarketingLayout>

<script>
  import { saveGoals } from "../lib/auth";
  import { supabase } from "../lib/supabase";

  const form = document.getElementById("onboarding-form") as HTMLFormElement;
  const status = document.getElementById("onboarding-status") as HTMLParagraphElement;
  const submitButton = form.querySelector('button[type="submit"]') as HTMLButtonElement;

  // Attach the submit handler before anything async, or a fast submit can race preventDefault() and fall through to a native GET.
  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    const data = new FormData(form);

    submitButton.disabled = true;
    status.textContent = "";

    const result = await saveGoals(Number(data.get("speedGoal")), Number(data.get("dailyMinutes")));

    if (result.error) {
      status.textContent = result.error;
      submitButton.disabled = false;
      return;
    }

    window.location.href = "/dashboard";
  });

  // Reads the name from session metadata, not getProfile() — a background profile fetch here could resolve after saveGoals() and clobber the cache with a stale snapshot.
  supabase.auth.getSession().then(({ data: { session } }) => {
    const name = session?.user?.user_metadata?.name;
    if (!name) return;
    const heading = document.querySelector(".auth-card h1");
    if (heading) heading.textContent = `Welcome, ${name}!`;
  });
</script>
