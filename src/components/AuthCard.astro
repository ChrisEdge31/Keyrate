---
interface Props {
  title: string;
  subtitle: string;
}

const { title, subtitle } = Astro.props;
---

<div class="auth-card">
  <h1>{title}</h1>
  <p class="subtitle">{subtitle}</p>
  <slot />
</div>

<style>
  .auth-card {
    max-width: 26rem;
    margin: 3rem auto 0;
    padding: 2rem;
    background-color: var(--primary-l1);
    border: 1px solid var(--primary-d1);
    border-radius: 8px;
  }

  .auth-card h1 {
    font-size: 1.5rem;
    margin: 0 0 0.5rem;
    text-align: center;
  }

  .subtitle {
    color: var(--secondary-d1);
    font-size: 0.9rem;
    text-align: center;
    margin: 0 0 1.5rem;
  }

  .auth-card :global(form) {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .auth-card :global(label) {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.9rem;
    color: var(--secondary-d1);
  }

  .auth-card :global(input) {
    padding: 0.6rem 0.75rem;
    border-radius: 6px;
    border: 1px solid var(--primary-d1);
    background-color: var(--primary);
    color: var(--Name-color);
    font-family: var(--default-font-family);
    font-size: 0.95rem;
  }

  .auth-card :global(input:focus) {
    outline: none;
    border-color: var(--accent);
  }

  .auth-card :global(button[type="submit"]) {
    margin-top: 0.5rem;
    padding: 0.7rem;
    border: none;
    border-radius: 6px;
    background-color: var(--accent);
    color: #fff;
    font-weight: 600;
    font-size: 0.95rem;
    cursor: pointer;
  }

  .auth-card :global(button[type="submit"]:hover) {
    background-color: var(--accent-l1);
  }

  .auth-card :global(.form-note) {
    margin-top: 1rem;
    font-size: 0.85rem;
    color: var(--secondary-d1);
    text-align: center;
  }

  .auth-card :global(.form-note a) {
    color: var(--Name-color);
  }

  .auth-card :global(.form-status) {
    font-size: 0.85rem;
    color: var(--error);
    text-align: center;
    min-height: 1.2em;
  }
</style>
